    <!-- Help -->
    <string name="how_to_use">Как пользоваться</string>
    <string name="help_server_setup">Настройка сервера</string>
    <string name="help_server_required">Для обработки нужен работающий сервер.</string>
    <string name="help_quick_start">Быстрый старт</string>
    <string name="help_local_files">Использование локальных файлов</string>
    <string name="help_share_yt">Поделиться из YouTube</string>
    <string name="help_ai_models">Модели ИИ</string>
    <string name="help_paste_link">Вставьте ссылку YouTube</string>
    <string name="help_paste_desc">Скопируйте URL из YouTube и вставьте в поле ввода. Также можно поделиться напрямую из приложения YouTube. Вставьте или отправьте сразу несколько ссылок, и они станут списком, который обработается по очереди. Можно также импортировать .txt-файл со ссылками.</string>
    <string name="help_tap_remove">Нажмите Убрать музыку</string>
    <string name="help_tap_remove_desc">Приложение скачает видео, отделит вокал с помощью ИИ и соберёт всё обратно.</string>
    <string name="help_play_save">Воспроизвести или сохранить</string>
    <string name="help_play_save_desc">После завершения воспроизведите результат или сохраните его в любое место на устройстве.</string>
    <string name="help_pick_file">Выбрать видеофайл</string>
    <string name="help_pick_file_desc">Вместо ссылки YouTube нажмите «Выбрать видеофайл», чтобы выбрать видео с устройства. Также можно поделиться видео- или аудиофайлом с Murem из любого приложения.</string>
    <string name="help_process_usual">Обработать как обычно</string>
    <string name="help_process_usual_desc">Приложение загружает файл на сервер, извлекает аудио, разделяет вокал и возвращает результат.</string>
    <string name="help_tap_share">Нажмите Поделиться в YouTube</string>
    <string name="help_tap_share_desc">Откройте любое видео в приложении YouTube и нажмите кнопку Поделиться.</string>
    <string name="help_pick_murem">Выберите Murem</string>
    <string name="help_pick_murem_desc">Выберите Murem в меню «Поделиться». URL заполнится автоматически.</string>
    <string name="help_local_termux">Локальный (Termux)</string>
    <string name="help_local_termux_desc">Обработка на телефоне. Установите Termux из F-Droid, затем перейдите в Настройки → Установить → Запустить. Медленнее, но полностью офлайн.</string>
    <string name="help_remote_server">Удалённый сервер</string>
    <string name="help_remote_server_desc">Запустите сервер на ПК с GPU для гораздо более быстрой обработки. Укажите URL в Настройки → Свой.</string>
    <string name="help_start_pc">Запустить сервер на ПК</string>
    <string name="help_start_pc_desc" tools:ignore="TypographyDashes">Сначала клонируйте репозиторий:\ngit clone https://github.com/Ignema/youtube-music-remover.git\ncd youtube-music-remover\n\nЗатем запустите сервер:\nuvx --with fastapi --with yt-dlp --with python-multipart --with \"audio-separator[gpu]\" --with zeroconf uvicorn api.main:app --host 0.0.0.0 --port 8000</string>
    <string name="help_docker">Docker (проще всего для ПК)</string>
    <string name="help_docker_desc">docker build -t murem api/\ndocker run -p 8000:8000 murem\n\nВот и всё — настраивать Python или ffmpeg не нужно.</string>

