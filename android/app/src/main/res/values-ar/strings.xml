    <!-- Help -->
    <string name="how_to_use">طريقة الاستخدام</string>
    <string name="help_server_setup">إعداد الخادم</string>
    <string name="help_server_required">يجب تشغيل خادم قبل أن يتمكن التطبيق من معالجة أي شيء.</string>
    <string name="help_quick_start">بدء سريع</string>
