<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the imported cookies.txt (account session tokens) never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies/" />
    </device-transfer>
</data-extraction-rules>
