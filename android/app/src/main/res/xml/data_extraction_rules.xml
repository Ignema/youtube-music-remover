<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Never leaves the device: the stored cookies.txt (account session tokens), the per-job
    work dirs (they hold a temporary cookies.txt copy while a link downloads) and the WebView data dir
    used by "Log in with browser".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies/" />
        <exclude domain="file" path="work/" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies/" />
        <exclude domain="file" path="work/" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
